---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/gsck-logo.png" alt="GSCK" width="48" height="48" />
      <div>
        <div class="ft-title">Grorud Spektra Cricket Klubb</div>
        <div class="ft-sub">Oslo, Norway · Est. 2026</div>
      </div>
    </div>

    <div class="footer-links">
      <a href="/team">Team</a>
      <a href="/matches">Matches</a>
      <a href="/open-day">Open Day</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-contact">
      <a href="mailto:spektraoslo@gmail.com">spektraoslo@gmail.com</a>
      <a href="https://www.instagram.com/grorud_cricket_klubb" target="_blank" rel="noopener">
        @grorud_cricket_klubb
      </a>
    </div>
  </div>

  <div class="footer-bottom container">
    <span>© {year} GSCK</span>
    <span>Built with Astro · Deployed on GitHub Pages</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding: 3rem 0 1.5rem;
    background: linear-gradient(180deg, transparent, rgba(255, 101, 0, 0.04));
    border-top: 1px solid var(--gsck-faint);
  }

  .footer-inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1.4fr 1fr 1fr;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gsck-faint);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .footer-brand img {
    width: 52px;
    height: 52px;
    object-fit: cover;
    border-radius: 50%;
    background: var(--gsck-black);
    border: 1.5px solid var(--gsck-orange-soft);
    padding: 3px;
  }

  .ft-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.05em;
  }

  .ft-sub {
    color: var(--gsck-mute);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer-links,
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .footer-links a,
  .footer-contact a {
    color: var(--gsck-mute);
  }

  .footer-links a:hover,
  .footer-contact a:hover {
    color: var(--gsck-orange);
  }

  .footer-bottom {
    padding-top: 1.5rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--gsck-mute);
    letter-spacing: 0.05em;
  }

  @media (max-width: 720px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
