---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/team', label: 'Team' },
  { href: '/matches', label: 'Matches' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/nets', label: 'Nets' },
  { href: '/open-day', label: 'Open Day' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="GSCK home">
      <img src="/gsck-logo.png" alt="GSCK" width="40" height="40" />
      <span class="brand-text">
        <span class="brand-title">GSCK</span>
        <span class="brand-sub">Grorud Spektra Cricket Klubb</span>
      </span>
    </a>

    <nav class="nav" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: currentPath === item.href.replace(/\/$/, '') }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 244, 238, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--gsck-faint);
  }

  .header-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--gsck-white);
    opacity: 1;
  }

  .brand img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 50%;
    background: var(--gsck-black);
    border: 1.5px solid var(--gsck-orange-soft);
    padding: 2px;
    box-shadow: 0 0 12px rgba(255, 101, 0, 0.35);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: 0.06em;
  }

  .brand-sub {
    font-size: 0.65rem;
    color: var(--gsck-mute);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .nav {
    display: flex;
    gap: 0.25rem;
    align-items: center;
  }

  .nav-link {
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gsck-mute);
    border-radius: var(--radius-pill);
    transition: color 0.15s, background 0.15s;
  }

  .nav-link:hover {
    color: var(--gsck-white);
    background: rgba(15, 15, 16, 0.05);
    opacity: 1;
  }

  .nav-link.active {
    color: var(--gsck-orange);
    background: var(--gsck-orange-dim);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--gsck-faint);
    border-radius: var(--radius-sm);
    padding: 10px 8px;
    cursor: pointer;
    flex-direction: column;
    gap: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--gsck-white);
    transition: transform 0.2s, opacity 0.2s;
  }

  @media (max-width: 900px) {
    .brand-sub { display: none; }

    .nav-toggle {
      display: flex;
    }

    .nav {
      position: absolute;
      inset: var(--nav-h) 0 auto 0;
      background: rgba(247, 244, 238, 0.98);
      backdrop-filter: blur(12px);
      flex-direction: column;
      padding: 1rem;
      gap: 0.25rem;
      border-bottom: 1px solid var(--gsck-faint);
      transform: translateY(-110%);
      transition: transform 0.2s ease;
    }

    .nav.open {
      transform: translateY(0);
    }

    .nav-link {
      width: 100%;
      text-align: center;
      padding: 0.85rem 1rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('.nav');
  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(!!isOpen));
  });
</script>
