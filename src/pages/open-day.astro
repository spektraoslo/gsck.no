---
import Layout from '../layouts/Layout.astro';

const obosUrl = 'https://www.obos.no';
const ncfUrl = 'https://cricketforbundet.no/gsck-open-day-2026-oppdag-cricket-for-barn-ungdom-og-kvinner/';

// Portrait photos (the rest are landscape); the band makes them 1200×1986 / 1800×1389.
const portrait = new Set([
  'dsc05640.jpg', 'dsc05734.jpg', 'dsc05740.jpg', 'dsc05800.jpg',
  'dsc05861.jpg', 'dsc05951.jpg', 'dsc06154.jpg', 'dsc06194.jpg',
]);
const ratioOf = (file: string) => (portrait.has(file) ? 1200 / 1986 : 1800 / 1389);
const ratio = (file: string) => ratioOf(file).toFixed(4);

/**
 * Splits photos into rows of 2–3 that fill the width: a row takes photos until their combined
 * aspect ratio would pass ~2.7 (two landscapes, or a portrait beside a landscape). A single
 * leftover photo joins the row before it, so no row is ever a lone photo.
 */
function toRows(photos: Photo[]): Photo[][] {
  const rows: Photo[][] = [];
  let row: Photo[] = [];
  let sum = 0;
  for (const ph of photos) {
    const r = ratioOf(ph.file);
    if (row.length > 0 && sum + r > 2.7) {
      rows.push(row);
      row = [];
      sum = 0;
    }
    row.push(ph);
    sum += r;
  }
  if (row.length === 1 && rows.length > 0) rows[rows.length - 1].push(row[0]);
  else if (row.length > 0) rows.push(row);
  return rows;
}

// Event photos in /public/openday-2026 (full size) and /openday-2026/thumb (grid).
// Every photo carries the OBOS sponsor band at the bottom, so the grid never crops them.
type Photo = { file: string; alt: string };
type PhotoGroup = { id: string; eyebrow: string; title: string; text: string; photos: Photo[] };

const photoGroups: PhotoGroup[] = [
  {
    id: 'together',
    eyebrow: 'All of us',
    title: 'One big GSCK family',
    text: 'Kids, parents, coaches and players — everyone who made the afternoon what it was.',
    photos: [
      { file: 'dsc06431.jpg', alt: 'Everyone at the Open Day gathered for a group photo on the grass' },
      { file: 'dsc06288.jpg', alt: 'Two GSCK coaches with a group of young players by the stumps' },
      { file: 'dsc05992.jpg', alt: 'Kids and coaches lined up on the pitch' },
      { file: 'dsc06390.jpg', alt: 'Children sitting together on the grass after the sessions' },
      { file: 'dsc05997.jpg', alt: 'A team of kids and coaches posing at the wicket' },
      { file: 'dsc06399.jpg', alt: 'Group photo of the kids under the big tree' },
    ],
  },
  {
    id: 'training',
    eyebrow: 'Open training & trials',
    title: 'Bat, ball and big smiles',
    text: 'Batting, bowling and fielding with our coaches — first-timers and little all-rounders side by side.',
    photos: [
      { file: 'dsc05529.jpg', alt: 'Kids gathering at the pitch for the first session' },
      { file: 'dsc05640.jpg', alt: 'A young batter taking guard' },
      { file: 'dsc05613.jpg', alt: 'A coach bowling to a young batter' },
      { file: 'dsc05800.jpg', alt: 'A boy playing a shot at the stumps' },
      { file: 'dsc05458.jpg', alt: 'Kids and coaches warming up by the stumps' },
      { file: 'dsc06154.jpg', alt: 'A young batter swinging hard' },
      { file: 'dsc05822.jpg', alt: 'A batter driving the ball with the keeper watching' },
      { file: 'dsc05734.jpg', alt: 'A bowler in full delivery stride' },
      { file: 'dsc05909.jpg', alt: 'A girl bowling while a coach and kids look on' },
      { file: 'dsc05740.jpg', alt: 'A young batter facing up with coaches behind the stumps' },
      { file: 'dsc05563.jpg', alt: 'Kids running drills on the outfield' },
      { file: 'dsc05916.jpg', alt: 'A girl batting in an outfield practice game' },
      { file: 'dsc06023.jpg', alt: 'A coach keeping wicket in a kids game' },
      { file: 'dsc05626.jpg', alt: 'A practice match on the long pitch' },
      { file: 'dsc06084.jpg', alt: 'A bowler running in under the trees' },
      { file: 'dsc06236.jpg', alt: 'A kids match with a GSCK player umpiring' },
      { file: 'dsc06113.jpg', alt: 'A practice match in progress' },
      { file: 'dsc05638.jpg', alt: 'Kids playing a game on the outfield' },
      { file: 'dsc06319.jpg', alt: 'A game on the main pitch' },
      { file: 'dsc06209.jpg', alt: 'GSCK players watching the kids play' },
    ],
  },
  {
    id: 'women',
    eyebrow: 'Shining ladies',
    title: 'Women take guard',
    text: 'The first steps towards a GSCK women’s team — coaches on hand and all equipment provided.',
    photos: [
      { file: 'dsc05951.jpg', alt: 'A girl bowling with a high arm' },
      { file: 'dsc05934.jpg', alt: 'A woman batting with a coach behind the stumps' },
      { file: 'dsc05984.jpg', alt: 'A woman bowling in a mixed game' },
      { file: 'dsc05861.jpg', alt: 'A coach helping a woman with her batting stance' },
    ],
  },
  {
    id: 'prizes',
    eyebrow: 'Goodie bags & refreshments',
    title: 'Trophies, treats & a chat',
    text: 'Trophies and goodie bags for the kids, plus snacks, drinks and a chat about where the club goes next.',
    photos: [
      { file: 'dsc05475.jpg', alt: 'A row of gold trophies on the prize table' },
      { file: 'dsc06215.jpg', alt: 'Trophies lined up on a table by the pitch' },
      { file: 'dsc06194.jpg', alt: 'GSCK volunteers serving refreshments in the tent' },
    ],
