const icons: Record<string, string> = {
  calendar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
  clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>`,
  pin: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-7.5-7-13a7 7 0 0 1 14 0c0 5.5-7 13-7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>`,
  people: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17" cy="9" r="2.5"/><path d="M15 20a4.5 4.5 0 0 1 6.5-4"/></svg>`,
  bat: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l4-4"/><path d="M8.5 15.5l-3-3L14 4l3 3z"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/></svg>`,
  team: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3"/><circle cx="5" cy="10" r="2.5"/><circle cx="19" cy="10" r="2.5"/><path d="M6 20a6 6 0 0 1 12 0"/><path d="M2 20a4 4 0 0 1 4-4"/><path d="M22 20a4 4 0 0 0-4-4"/></svg>`,
  whistle: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6c-4.4 0-8 3.6-8 8s3.6 8 8 8 8-3.6 8-8v-3l-5-5z"/><path d="M17 3l3 3"/><circle cx="14" cy="14" r="2"/></svg>`,
  heart: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 6C19 16.5 12 21 12 21z"/></svg>`,
  gift: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v14M5 12v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9"/><path d="M12 8s-2-4-5-4a2.5 2.5 0 0 0 0 5"/><path d="M12 8s2-4 5-4a2.5 2.5 0 0 1 0 5"/></svg>`,
  cup: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5h12v8a6 6 0 0 1-12 0z"/><path d="M17 8h2a2 2 0 0 1 0 4h-2"/><path d="M4 22h14"/></svg>`,
};

const experiences = [
  { title: 'Open Training & Trials',      desc: 'Batting, bowling and wicket-keeping — everyone tried it all with our coaches.', icon: 'bat' },
  { title: 'Team Distribution & Formation', desc: 'Kids were placed into teams, met their squads and played together.', icon: 'team' },
  { title: 'Pro Coaching',                  desc: 'Experienced, supportive coaches — and plenty of first-timers.', icon: 'whistle' },
  { title: 'Fun · Inclusive · Team Spirit', desc: 'A friendly, welcoming atmosphere from the very first ball.', icon: 'heart' },
  { title: 'Goodie Bags for All Kids',      desc: 'Every child went home with a GSCK goodie bag.', icon: 'gift' },
  { title: 'Refreshments & Club Vision Q&A', desc: 'Snacks, drinks, and a chat with the club about what comes next.', icon: 'cup' },
];

const infoStrip = [
  { label: 'Date',  value: 'Sat, 16 August 2026', icon: 'calendar' },
  { label: 'Time',  value: '14:00 – 19:00',        icon: 'clock' },
  { label: 'Venue', value: 'Rommen Mini, Oslo',    icon: 'pin' },
  { label: 'Supported by', value: 'OBOS gir tilbake', icon: 'heart' },
];
---

<Layout
  title="Open Day"
  description="GSCK Open Day 2026 — Cricket for Kids & Women, held on 16 August 2026 at Rommen Mini, Oslo, with support from OBOS. Photos and highlights from the day."
>
  <!-- ── HERO ────────────────────────────────────────────── -->
  <section class="od-hero">
    <div class="od-hero-bg" aria-hidden="true">
      <div class="dot d1"></div>
      <div class="dot d2"></div>
      <div class="dot d3"></div>
      <div class="dot d4"></div>
      <div class="dot d5"></div>
      <div class="grid-lines"></div>
    </div>

    <div class="container od-hero-inner">
      <div class="od-hero-text">
        <span class="pulse-pill">
          <span class="dot-done" aria-hidden="true">✓</span>
          Held on 16 August 2026 · Thank you!
        </span>
        <h1>
          <span class="over">Cricket for</span>
          <span class="main"><em>Kids</em> &amp; <em>Women</em></span>
          <span class="under">Open Day</span>
        </h1>
        <p class="lead">
          New friends, new experiences and lots of fun — GSCK threw open the gates for
          the community, and the community came. Kids and women of all ages and levels
          picked up a bat at Rommen, many of them for the very first time.
        </p>

        <a class="sponsor-chip" href={obosUrl} target="_blank" rel="noopener" aria-label="OBOS — go to obos.no">
          <span class="sponsor-chip-label">Supported by</span>
          <img src="/obos-spons-hvit-idrett.svg" alt="OBOS — Vi gir tilbake til idrett" />
        </a>

        <div class="od-cta">
          <a class="btn" href="#photos">See the photos ↓</a>
        </div>
      </div>

      <div class="od-hero-visual">
        <div class="collage">
          <div class="tile tile-photo">
            <img src="/openday-2026/hero/kids-playing.jpg" alt="A boy bowling to a young batter on the pitch at GSCK Open Day 2026" />
          </div>
          <div class="tile tile-illo">
            <img src="/openday-2026/hero/girl-batting.jpg" alt="A girl batting at GSCK Open Day 2026" />
          </div>
          <div class="badge-float" aria-hidden="true">
            <img src="/gsck-logo.png" alt="" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INFO STRIP ─────────────────────────────────────── -->
  <section class="od-info">
    <div class="container">
      <div class="info-grid">
        {infoStrip.map((i) => (
          <div class="info-item">
            <div class="info-icon" set:html={icons[i.icon]}></div>
            <div class="info-body">
              <div class="info-label">{i.label}</div>
              <div class="info-value">{i.value}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PHOTOS ─────────────────────────────────────────── -->
  <section id="photos" class="section photos">
    <div class="container">
      <div class="section-eyebrow">The day in pictures</div>
      <h2 class="section-title">What an afternoon it was</h2>

      <nav class="photo-jump" aria-label="Photo sections">
        {photoGroups.map((g) => (
          <a href={`#photos-${g.id}`}>{g.eyebrow}</a>
        ))}
      </nav>

      {photoGroups.map((g, gi) => (
        <section id={`photos-${g.id}`} class="pgroup" aria-labelledby={`pg-title-${g.id}`}>
          <header class="pgroup-head">
            <span class="pgroup-num" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span>
            <div>
              <span class="pgroup-eyebrow">{g.eyebrow}</span>
              <h3 id={`pg-title-${g.id}`}>{g.title}</h3>
              <p>{g.text}</p>
            </div>
          </header>

          <div class="rows">
            {toRows(g.photos).map((row) => (
              <div class="prow">
                {row.map((ph) => (
                  <a class="ph" style={`--r:${ratio(ph.file)}`} href={`/openday-2026/${ph.file}`} data-lightbox aria-label={`Open photo: ${ph.alt}`}>
                    <img src={`/openday-2026/thumb/${ph.file}`} alt={ph.alt} loading={gi === 0 ? 'eager' : 'lazy'} decoding="async" />
                    <span class="ph-zoom" aria-hidden="true">⤢</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <!-- ── SPONSOR ────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="sponsor-panel">
        <div class="sponsor-text">
          <span class="sponsor-eyebrow">Our sponsor</span>
          <h2>Thank you, OBOS</h2>
          <p>
            GSCK Open Day 2026 was sponsored by OBOS through <strong>OBOS gir tilbake</strong>.
          </p>
          <p class="sponsor-tag">#obosgirtilbake</p>
        </div>
        <a class="sponsor-logo" href={obosUrl} target="_blank" rel="noopener" aria-label="OBOS — go to obos.no">
          <img src="/obos-spons-hvit-idrett.svg" alt="OBOS — Vi gir tilbake til idrett" />
        </a>
      </div>
    </div>
  </section>

  <!-- ── WHAT WE DID ────────────────────────────────────── -->
  <section id="details" class="section">
    <div class="container">
      <div class="section-eyebrow">What we did</div>
      <h2 class="section-title">A whole afternoon of cricket</h2>
      <p class="od-sub">
        Whether they had never held a bat or had been playing for years, there was a spot
        for everyone.
      </p>

      <div class="exp-grid">
        {experiences.map((e) => (
          <article class="exp-card">
            <div class="exp-icon" set:html={icons[e.icon]}></div>
            <h3>{e.title}</h3>
            <p>{e.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── POSTER ─────────────────────────────────────────── -->
  <section id="poster" class="section">
    <div class="container">
      <div class="cta-poster">
        <a href="/openday-poster.jpg" target="_blank" rel="noopener" aria-label="View the full Open Day poster">
          <img src="/openday-poster.jpg" alt="GSCK Open Day poster, supported by OBOS" />
        </a>
        <a class="ncf-link" href={ncfUrl} target="_blank" rel="noopener">
          <span class="ncf-label">Announced by Norges Cricketforbund</span>
          <span class="ncf-title">GSCK Åpen dag 2026 – Oppdag cricket for barn, ungdom og kvinner</span>
          <span class="ncf-cta">Read on cricketforbundet.no ↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── LOCATION ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">Where it happened</div>
      <h2 class="section-title">Rommen Mini, Oslo</h2>
      <p class="od-sub">
        Haavard Martinsens vei 35, 0978 Oslo
      </p>
      <div class="map">
        <iframe
          title="Map to Haavard Martinsens vei 35, 0978 Oslo"
          src="https://www.google.com/maps?q=Haavard+Martinsens+vei+35,+0978+Oslo&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="map-cta">
        <a class="btn ghost" href="https://share.google/zTTNx78C1HcgClp6c" target="_blank" rel="noopener">
          Open in Google Maps ↗
        </a>
      </p>
    </div>
  </section>
</Layout>

<dialog class="lightbox" aria-label="Photo viewer">
  <img alt="" />
  <button type="button" class="lb-btn lb-close" aria-label="Close">✕</button>
  <button type="button" class="lb-btn lb-prev" aria-label="Previous photo">‹</button>
  <button type="button" class="lb-btn lb-next" aria-label="Next photo">›</button>
  <span class="lb-count" aria-live="polite"></span>
</dialog>

<script is:inline>
  (function () {
    const dialog = document.querySelector('.lightbox');
    const links = Array.from(document.querySelectorAll('a[data-lightbox]'));
    if (!dialog || !dialog.showModal || links.length === 0) return;
    const img = dialog.querySelector('img');
    const count = dialog.querySelector('.lb-count');
    let index = 0;
    function show(i) {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.getAttribute('href');
      img.alt = link.querySelector('img').alt;
      count.textContent = index + 1 + ' / ' + links.length;
    }
    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('.lb-close').addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev').addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lb-next').addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => img.removeAttribute('src'));
  })();
</script>

<style>
  /* ── Reused ─────────────────────────────────────────── */
  .od-sub {
    color: var(--gsck-mute);
    max-width: 60ch;
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }

  /* ── HERO ───────────────────────────────────────────── */
  .od-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(4rem, 10vw, 7rem);
    background:
      radial-gradient(ellipse 60% 50% at 80% 20%, rgba(255, 101, 0, 0.15), transparent 70%),
      radial-gradient(ellipse 50% 40% at 15% 80%, rgba(255, 101, 0, 0.10), transparent 70%);
  }

  .od-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .grid-lines {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 101, 0, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 101, 0, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
  .dot {
    position: absolute;
    width: 10px; height: 10px;
    border-radius: 50%;
    background: var(--gsck-orange);
    opacity: 0.5;
    filter: blur(0.5px);
  }
  .d1 { top: 12%; left: 6%;   animation: bob 5s ease-in-out infinite;   }
  .d2 { top: 78%; left: 12%;  animation: bob 7s ease-in-out infinite reverse; }
  .d3 { top: 18%; right: 20%; animation: bob 6s ease-in-out infinite;  }
  .d4 { top: 82%; right: 8%;  animation: bob 4.5s ease-in-out infinite reverse; }
  .d5 { top: 50%; left: 48%;  opacity: 0.25; animation: bob 8s ease-in-out infinite; }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-14px); }
  }

  .od-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .pulse-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--gsck-orange-soft);
    background: var(--gsck-orange-dim);
    color: var(--gsck-orange);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
  }
  h1 {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    line-height: 0.92;
    letter-spacing: 0.03em;
  }
  h1 .over  {
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--gsck-mute);
    font-family: var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 0.6rem;
  }
  h1 .main    { font-size: clamp(3rem, 8vw, 6rem);   color: var(--gsck-white); }
  h1 .main em { font-style: normal; color: var(--gsck-orange); }
  h1 .under   { font-size: clamp(2rem, 5vw, 3.4rem); color: var(--gsck-white); margin-top: 0.15em; }

  .lead {
    color: var(--gsck-mute);
    font-size: clamp(1rem, 1.35vw, 1.1rem);
    max-width: 50ch;
    margin-top: 1.5rem;
    line-height: 1.7;
  }

  .dot-done {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--gsck-orange);
    color: var(--on-orange);
    display: grid; place-items: center;
    font-size: 0.6rem;
    letter-spacing: 0;
  }

  /* OBOS sponsor chip in the hero — white logo on OBOS Blå, as the guidelines ask */
  .sponsor-chip {
    display: inline-flex;
    align-items: center;
    /* OBOS clear zone: at least the height of the "S" (64% of the logo height ≈ 17px)
       between the logo and anything else, the label and the chip's edges included. */
    gap: 1.25rem;
    margin: 1.75rem 0 1.5rem;
    padding: 1.15rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--obos-blue);
    opacity: 1;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .sponsor-chip:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0, 71, 186, 0.3); opacity: 1; }
  .sponsor-chip-label {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.62rem;
