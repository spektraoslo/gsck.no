---
import Layout from '../layouts/Layout.astro';

const contacts = [
  {
    kind: 'email',
    label: 'Email',
    value: 'spektraoslo@gmail.com',
    href: 'mailto:spektraoslo@gmail.com',
    cta: 'Send a message',
  },
  {
    kind: 'instagram',
    label: 'Instagram',
    value: '@grorud_cricket_klubb',
    href: 'https://www.instagram.com/grorud_cricket_klubb',
    cta: 'Follow us',
  },
];

const icons: Record<string, string> = {
  email: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>`,
};
---

<Layout title="Contact">
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">Get in touch</div>
      <h1 class="section-title">Contact</h1>
      <div class="contact-grid">
        {contacts.map((c) => (
          <a class:list={['contact-card', c.kind]} href={c.href} target={c.kind === 'instagram' ? '_blank' : undefined} rel={c.kind === 'instagram' ? 'noopener' : undefined}>
            <div class="cc-icon" set:html={icons[c.kind]}></div>
            <div class="cc-body">
              <span class="cc-label">{c.label}</span>
              <span class="cc-value">{c.value}</span>
            </div>
            <span class="cc-cta">
              {c.cta}
              <span class="cc-arrow">→</span>
            </span>
          </a>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .contact-card {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    background: linear-gradient(180deg, rgba(15, 15, 16, 0.04), rgba(15, 15, 16, 0.02));
    border: 1px solid var(--gsck-faint);
    border-radius: var(--radius-lg);
    color: var(--gsck-white);
    opacity: 1;
    transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s, background 0.15s;
  }

  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--gsck-orange-soft);
    box-shadow: 0 10px 40px rgba(255, 101, 0, 0.15);
    background: linear-gradient(180deg, rgba(255, 101, 0, 0.06), rgba(255, 101, 0, 0.02));
    opacity: 1;
  }

  .cc-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--gsck-orange);
    color: var(--gsck-black);
    display: grid;
    place-items: center;
    box-shadow: 0 6px 20px rgba(255, 101, 0, 0.35);
    flex-shrink: 0;
  }
  .cc-icon :global(svg) { width: 28px; height: 28px; }

  .contact-card.instagram .cc-icon {
    background: linear-gradient(135deg, #FF6500, #d94a00);
  }

  .cc-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .cc-label {
    color: var(--gsck-mute);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .cc-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--gsck-white);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cc-address {
    color: var(--gsck-mute);
    font-size: 0.85rem;
    margin-top: 4px;
  }

  .cc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--gsck-orange);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    white-space: nowrap;
  }
  .cc-arrow { transition: transform 0.15s; display: inline-block; }
  .contact-card:hover .cc-arrow { transform: translateX(4px); }

  @media (max-width: 720px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-card {
      grid-template-columns: 56px 1fr;
      row-gap: 0.85rem;
    }
    .cc-cta {
      grid-column: 1 / -1;
      padding-left: calc(56px + 1.25rem);
    }
  }
</style>
