---
import Layout from '../layouts/Layout.astro';

type Media =
  | { kind: 'video';  src: string; caption: string; size: 'hero' | 'tall' | 'wide' }
  | { kind: 'photo';  src: string; alt: string;      caption: string; size: 'hero' | 'tall' | 'wide' };

// Bento grid ordering — Team hero at top, then videos + photos mixed with rhythm.
// Video src includes #t=0.5 so browsers show the frame at 0.5s as the poster.
const media: Media[] = [
  { kind: 'photo', src: '/team-wide.jpg',       alt: 'GSCK squad group photo on the ground',            caption: 'The squad',                   size: 'hero' },
  { kind: 'video', src: '/gallery-video-1.mp4#t=0.5', caption: 'Match action · June 2026',              size: 'wide' },
  { kind: 'photo', src: '/gallery-batter.jpg',  alt: 'GSCK batter with a helmet full of cricket balls', caption: 'Well played',                 size: 'tall' },
  { kind: 'photo', src: '/gallery-fielder.jpg', alt: 'GSCK fielder in ready stance',                    caption: 'On the field',                size: 'tall' },
  { kind: 'photo', src: '/gallery-dugout.jpg',  alt: 'GSCK squad in the dugout with a scoreboard reading TOT W TOW DLS', caption: 'Dugout view · scoreboard side', size: 'wide' },
  { kind: 'video', src: '/gallery-video-2.mp4#t=0.5', caption: 'Nets session',                          size: 'tall' },
];

const instaUrl = 'https://www.instagram.com/grorud_cricket_klubb';

const iconInstagram = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>`;
---

<Layout title="Gallery">
  <section class="section">
    <div class="container">
      <div class="section-eyebrow">Moments</div>
      <h1 class="section-title">Gallery</h1>
      <p class="lede">A look at the squad on the field, on the boundary, and in the dugout.</p>

      <!-- Bento collage -->
      <div class="bento">
        {media.map((m) => (
          <figure class:list={['cell', `cell-${m.size}`, `cell-${m.kind}`]}>
            {m.kind === 'video' ? (
              <video
                src={m.src}
                controls
                muted
                playsinline
                preload="metadata"
                controlslist="nodownload nomute noremoteplayback"
                disablepictureinpicture
                data-force-muted
              >
                Your browser does not support the video tag.
              </video>
            ) : (
              <a class="cell-link" href={m.src} target="_blank" rel="noopener" aria-label={m.alt}>
                <img src={m.src} alt={m.alt} loading="lazy" />
              </a>
            )}
            <figcaption>
              <span class="cap-kind">{m.kind === 'video' ? '▶ Video' : '◱ Photo'}</span>
              <span class="cap-text">{m.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <script is:inline>
        // Enforce mute on all gallery videos across all browsers.
        // controlsList="nomute" hides the button in Chrome but not Firefox/Safari,
        // so we re-mute on any volumechange event as a safety net.
        document.querySelectorAll('video[data-force-muted]').forEach((v) => {
          v.muted = true;
          v.volume = 0;
          v.addEventListener('volumechange', () => {
            if (!v.muted || v.volume > 0) {
              v.muted = true;
              v.volume = 0;
            }
          });
        });
      </script>

      <!-- Instagram CTA -->
      <aside class="insta-card">
        <div class="ic-icon-wrap" aria-hidden="true">
          <div class="ic-glow"></div>
          <div class="ic-icon" set:html={iconInstagram}></div>
        </div>
        <div class="ic-content">
          <span class="ic-eyebrow">More moments</span>
          <h2 class="ic-title">Follow us on Instagram</h2>
          <p class="ic-desc">Training clips, match updates, and behind-the-scenes from the squad.</p>
          <a class="ic-btn" href={instaUrl} target="_blank" rel="noopener">
            <span>@grorud_cricket_klubb</span>
            <span class="ic-arrow">↗</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .lede {
    color: var(--gsck-mute);
    max-width: 60ch;
    font-size: 1.05rem;
    margin-top: 0.5rem;
    margin-bottom: 2.5rem;
  }

  /* ── Bento grid ────────────────────────────── */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 140px;
    gap: 0.9rem;
    margin-bottom: 4rem;
  }

  .cell {
    position: relative;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--gsck-faint);
    background: #0d0d0d; /* dark tile bg for videos before first frame */
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .cell:hover {
    transform: translateY(-3px);
    border-color: var(--gsck-orange-soft);
    box-shadow: 0 15px 40px rgba(255, 101, 0, 0.18);
  }

  .cell img,
  .cell video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #000;
  }

  .cell-link {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 1;
  }
  .cell-link:hover { opacity: 1; }
  .cell-link img { transition: transform 0.5s; }
  .cell:hover .cell-link img { transform: scale(1.04); }

  /* Grid spans by size (desktop, 4 cols) */
  .cell-hero { grid-column: span 4; grid-row: span 3; } /* full-width landscape hero */
  .cell-wide { grid-column: span 2; grid-row: span 3; } /* landscape */
  .cell-tall { grid-column: span 1; grid-row: span 3; } /* portrait */

  /* Caption overlay */
  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2rem 0.9rem 0.75rem;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.88));
    color: #ffffff;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .cell:hover figcaption { opacity: 1; }

  .cap-kind {
    color: var(--gsck-orange);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    flex-shrink: 0;
  }
  .cap-text {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.85); /* white on dark caption overlay */
    text-align: right;
  }

  /* Tablet */
  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
    .cell-hero { grid-column: span 2; grid-row: span 3; }
    .cell-wide { grid-column: span 2; grid-row: span 2; }
    .cell-tall { grid-column: span 1; grid-row: span 3; }
  }

  /* Mobile */
  @media (max-width: 520px) {
    .bento { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .cell-hero,
    .cell-wide,
    .cell-tall {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 4 / 3;
    }
    .cell-tall { aspect-ratio: 3 / 4; }
    figcaption { opacity: 1; } /* always visible on mobile */
  }

  /* ── Instagram card ────────────────────────── */
  .insta-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 2.25rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 20% 30%, rgba(255, 101, 0, 0.18), transparent 60%),
      linear-gradient(180deg, rgba(15, 15, 16, 0.04), rgba(15, 15, 16, 0.02));
    border: 1px solid var(--gsck-orange-soft);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .ic-icon-wrap {
    position: relative;
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }

  .ic-glow {
    position: absolute;
    inset: -6px;
    border-radius: 30px;
    background: conic-gradient(
      from 210deg,
      #FF6500 0deg,
      #ffb976 90deg,
      #d94a00 200deg,
      #FF6500 360deg
    );
    filter: blur(14px);
    opacity: 0.65;
    z-index: 0;
    animation: spin 8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .ic-icon {
    position: relative;
    z-index: 1;
    width: 96px;
    height: 96px;
    border-radius: 24px;
    background: linear-gradient(135deg, #FF6500, #d94a00);
    color: var(--gsck-black);
    display: grid;
    place-items: center;
    box-shadow: 0 12px 30px rgba(255, 101, 0, 0.5);
  }
  .ic-icon :global(svg) { width: 48px; height: 48px; }

  .ic-content { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .ic-eyebrow {
    color: var(--gsck-orange);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .ic-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 0.15rem 0 0.35rem;
  }
  .ic-desc {
    color: var(--gsck-mute);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 0.85rem;
  }

  .ic-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--gsck-orange);
    color: var(--gsck-black);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    align-self: flex-start;
    opacity: 1;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .ic-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(255, 101, 0, 0.4);
    opacity: 1;
  }
  .ic-arrow {
    display: inline-block;
    transition: transform 0.15s;
    font-weight: 700;
  }
  .ic-btn:hover .ic-arrow { transform: translate(3px, -3px); }

  @media (max-width: 600px) {
    .insta-card {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
      padding: 1.75rem 1.5rem;
    }
    .ic-btn { align-self: center; }
  }
</style>
